{
  "name": "style-guide-project",
  "version": "1.0.0",
  "private": true,
  "description": "Руководство по стилю документации ДелоТрек (Docs as Code)",
  "scripts": {
    "lint": "npm run lint:md && npm run lint:text",
    "lint:md": "markdownlint-cli2",
    "lint:text": "textlint --rulesdir .textlint/rules \"docs/**/*.md\" README.md CONTRIBUTING.md \"examples/after/**/*.md\"",
    "lint:fix": "markdownlint-cli2 --fix && textlint --fix --rulesdir .textlint/rules \"docs/**/*.md\"",
    "build": "mkdocs build --strict",
    "serve": "mkdocs serve"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "markdownlint-cli2": "^0.23.3",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-no-empty-section": "^1.1.0",
    "textlint-rule-prh": "^6.1.0",
    "textlint-rule-sentence-length": "^5.2.1"
  }
}
